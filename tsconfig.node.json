{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "allowJs": true,
    "checkJs": false,
    "emitDeclarationOnly": true,
    "outDir": "./node_modules/.cache/tsbuild"
  },
  "include": [
    "vite.config.ts"
  ]
}